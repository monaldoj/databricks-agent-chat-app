# Databricks CLI profile used by local development commands.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Optional local agent configuration.
GENIE_SPACE_IDS=
LAKEBASE_PROJECT_ID=
MLFLOW_EXPERIMENT_ID=
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_TRACING_DESTINATION=
MLFLOW_TRACING_SQL_WAREHOUSE_ID=

# `uv run setup-mlflow-experiment` writes the experiment, tracing, and Lakebase
# values above, plus target-specific DAB values under .databricks/bundle/<target>/.
# It pins the app name and Lakebase project there; use --app-name to choose the
# former, and expect the latter to be timestamped when a new project is needed.
#
# Single-deploy bundle overrides:
# BUNDLE_VAR_app_name=agent-my-assistant
# BUNDLE_VAR_genie_space_ids=01f...,01f...
# BUNDLE_VAR_lakebase_project_id=agent-my-assistant-lakebase
